<title>LIVE DISH-AI AR Menu</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="AR Menu by LIVE DISH-AI. Guests scan, place and order 3D dishes on their own table, with AI choosing what to show.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap">
<style>
/* Layout: frosted-glass UI floating over a fixed WebGL scene. A sticky 5-step story (scan, browse,
   place, ask, order) drives a 3D carousel by scroll. Mint marks AR, amber marks AI, everywhere. */
:root{
  --ink:#06100e; --mint:#58f0c0; --amber:#ffc15e; --coral:#ff6b5a; --sky:#69b4ff; --text:#eefaf6; --dim:#9db8b0;
  --glass:rgba(255,255,255,.075); --glass2:rgba(255,255,255,.13); --edge:rgba(255,255,255,.22);
  --display:'Unbounded','Arial Black',system-ui,sans-serif;
  --body:'Hanken Grotesk',system-ui,-apple-system,'Segoe UI',sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;background:var(--ink)}
body{background:var(--ink);color:var(--text);font:400 16px/1.6 var(--body);overflow-x:clip;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer}
::selection{background:var(--mint);color:#04120d}
:focus-visible{outline:2px solid var(--mint);outline-offset:3px;border-radius:8px}
.wrap{width:100%;max-width:1220px;margin-inline:auto;padding-left:max(18px,env(safe-area-inset-left,0px));padding-right:max(18px,env(safe-area-inset-right,0px))}
h1,h2,h3,h4{font-family:var(--display);font-weight:700;letter-spacing:-.03em;line-height:1.1;text-wrap:balance}

/* backdrop blobs: the colour the glass blurs */
.bg{position:fixed;inset:0;z-index:0;overflow:hidden;background:radial-gradient(ellipse at 50% 120%,#0c2a22,var(--ink) 60%)}
.bg i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;animation:drift 26s ease-in-out infinite alternate}
.bg i:nth-child(1){width:46vmax;height:46vmax;left:-12vmax;top:-10vmax;background:#12b886}
.bg i:nth-child(2){width:40vmax;height:40vmax;right:-14vmax;top:12vh;background:#ff6b5a;opacity:.38;animation-delay:-8s}
.bg i:nth-child(3){width:34vmax;height:34vmax;left:22vw;bottom:-18vmax;background:#3a7bff;opacity:.4;animation-delay:-15s}
.bg i:nth-child(4){width:24vmax;height:24vmax;right:20vw;bottom:8vh;background:#ffb02e;opacity:.28;animation-delay:-4s}
@keyframes drift{to{transform:translate3d(6vmax,4vmax,0) scale(1.15)}}
#gl{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
main,footer{position:relative;z-index:2}

/* glass */
.glass{background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.045));border:1px solid var(--edge);-webkit-backdrop-filter:blur(22px) saturate(150%);backdrop-filter:blur(22px) saturate(150%);box-shadow:0 24px 60px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.3),inset 0 -1px 0 rgba(255,255,255,.05)}
.chip{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:20px;padding:0 8px;border-radius:999px;font:700 10.5px/1 var(--display);letter-spacing:.02em;flex:none}
.chip.ar{background:rgba(88,240,192,.16);color:var(--mint);border:1px solid rgba(88,240,192,.5)}
.chip.ai{background:rgba(255,193,94,.16);color:var(--amber);border:1px solid rgba(255,193,94,.5)}
.line{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#d6e8e2;line-height:1.45}
.line .chip{margin-top:1px}

/* header */
header{position:fixed;inset:0 0 auto 0;z-index:100;padding-top:calc(10px + env(safe-area-inset-top,0px))}
.bar{display:flex;align-items:center;justify-content:space-between;gap:14px;height:58px;padding:0 10px 0 20px;border-radius:999px}
.logo{font:700 15px var(--display);letter-spacing:-.03em;white-space:nowrap}
.logo b{color:var(--mint)}
.logo small{font:500 11px var(--body);color:var(--dim);margin-left:8px;letter-spacing:0}
.links{display:flex;gap:26px}
.links a{font-size:14px;color:#cfe5de;transition:color .2s}
.links a:hover{color:var(--mint)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 22px;border-radius:999px;border:1px solid transparent;font-weight:700;font-size:14px;transition:transform .25s,box-shadow .25s,background .25s}
.btn-main{background:linear-gradient(120deg,var(--mint),#9af7d8);color:#04140e;box-shadow:0 10px 30px rgba(88,240,192,.28)}
.btn-main:hover{transform:translateY(-2px);box-shadow:0 16px 38px rgba(88,240,192,.42)}
.btn-glass{background:var(--glass);border-color:var(--edge)}
.btn-glass:hover{background:var(--glass2)}
.burger{display:none;width:44px;height:44px;border-radius:50%;border:1px solid var(--edge);background:var(--glass);position:relative}
.burger span{position:absolute;left:13px;right:13px;height:2px;border-radius:2px;background:var(--text);transition:.3s}
.burger span:nth-child(1){top:18px}.burger span:nth-child(2){top:24px}
.burger[aria-expanded="true"] span:nth-child(1){top:21px;transform:rotate(45deg)}
.burger[aria-expanded="true"] span:nth-child(2){top:21px;transform:rotate(-45deg)}

/* STORY */
.story{height:540vh}
.stick{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
.story-grid{height:100%;display:grid;grid-template-columns:minmax(0,470px) 1fr;gap:20px;align-items:center;padding-top:calc(76px + env(safe-area-inset-top,0px));padding-bottom:30px}
.panel{padding:30px;border-radius:30px;position:relative;z-index:3}
.step{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12.5px;color:var(--dim);margin-bottom:18px}
.step b{color:var(--text);font-weight:600}
.dots{display:flex;gap:6px}
.dots i{width:22px;height:4px;border-radius:4px;background:rgba(255,255,255,.18);transition:background .3s,width .3s}
.dots i.on{background:var(--mint);width:34px}
.panel h1,.panel h2{font-size:clamp(25px,3.1vw,40px);margin-bottom:14px}
.panel .desc{color:#cfe5de;margin-bottom:20px;font-size:16px}
.panel .lines{display:grid;gap:12px;padding-top:18px;border-top:1px solid var(--edge)}
.swap{transition:opacity .22s,transform .22s}
.swap.out{opacity:0;transform:translateY(8px)}
.cta-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}
.scrollhint{display:flex;align-items:center;gap:10px;margin-top:20px;font-size:12.5px;color:var(--dim);transition:opacity .4s}
.scrollhint:before{content:"";width:18px;height:28px;border-radius:10px;border:1.5px solid var(--dim);background:linear-gradient(var(--mint),var(--mint)) 50% 6px/3px 6px no-repeat;animation:wheel 1.6s infinite}
@keyframes wheel{50%{background-position:50% 14px}}
.area{position:relative;height:90%;min-width:0;touch-action:pan-y}
.labels{position:absolute;inset:0;pointer-events:none;z-index:4}
.lab{position:absolute;left:0;top:0;width:230px;padding:13px 15px;border-radius:18px;display:grid;gap:7px;opacity:0;transition:opacity .45s;will-change:transform}
.lab.r{translate:0 -50%}.lab.l{translate:-100% -50%}.lab.c{translate:-50% 0}
.lab h4{font-size:13px;letter-spacing:-.02em}
.lab .line{font-size:12.5px}
.lab .mc{display:none;gap:6px}
.lab.mini{width:auto;padding:9px 12px;gap:5px}
.lab.mini .line{display:none}
.lab.mini .mc{display:flex}
.toast{position:absolute;left:50%;bottom:6%;translate:-50% 0;display:flex;align-items:center;gap:12px;padding:12px 18px;border-radius:999px;font-size:14px;font-weight:600;opacity:0;transform:translateY(14px);transition:opacity .4s,transform .4s;z-index:5;white-space:nowrap}
.toast.on{opacity:1;transform:none}
.toast .ok{width:26px;height:26px;border-radius:50%;display:grid;place-items:center;background:var(--mint);color:#04140e;font-size:14px}
.nogl-msg{display:none}
.no-gl .nogl-msg{display:grid;place-items:center;height:100%;color:var(--dim);text-align:center;padding:20px}

/* SECTIONS */
section.s{padding-block:clamp(72px,10vw,130px)}
.head{max-width:700px;margin-bottom:44px}
.head .tag{display:inline-flex;gap:8px;margin-bottom:16px}
.head h2{font-size:clamp(28px,4.2vw,52px);margin-bottom:16px}
.head p{color:#cfe5de;max-width:36em}
.duo{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.duo .glass{padding:32px;border-radius:30px}
.duo h3{font-size:clamp(22px,2.6vw,32px);margin:14px 0 8px}
.duo p{color:#cfe5de;margin-bottom:18px}
.duo ul{list-style:none;display:grid;gap:10px}
.duo li{display:flex;gap:10px;font-size:15px;color:#e2f2ed;padding:11px 0;border-top:1px solid var(--edge)}
.duo li:before{content:"✓";font-weight:700}
.duo .arc li:before{color:var(--mint)}.duo .aic li:before{color:var(--amber)}
.fgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.card{padding:26px;border-radius:26px;display:flex;flex-direction:column;gap:14px;min-width:0;transition:transform .25s ease-out,border-color .3s;transform-style:preserve-3d}
.card:hover{border-color:rgba(255,255,255,.4)}
.card .orb{width:56px;height:56px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(145deg,rgba(88,240,192,.35),rgba(255,193,94,.3));border:1px solid var(--edge);font:700 14px var(--display);transform:translateZ(36px);box-shadow:0 12px 30px rgba(0,0,0,.3)}
.card h3{font-size:18px;transform:translateZ(20px)}
.card .lines{display:grid;gap:10px;padding-top:14px;border-top:1px solid var(--edge)}

/* phone demo */
.demo{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center}
.pscene{perspective:1100px;display:grid;place-items:center;min-height:600px;position:relative}
.phone{--rx:6deg;--ry:-20deg;position:relative;width:268px;height:540px;border-radius:44px;padding:10px;transform-style:preserve-3d;transform:rotateX(var(--rx)) rotateY(var(--ry));transition:transform .15s linear}
.phone:before{content:"";position:absolute;inset:0;border-radius:inherit;transform:translateZ(-18px);background:rgba(88,240,192,.12);border:1px solid var(--edge)}
.screen{height:100%;border-radius:36px;padding:18px 16px;display:flex;flex-direction:column;gap:12px;background:linear-gradient(170deg,rgba(14,50,40,.9),rgba(8,20,18,.95));overflow:hidden;position:relative}
.screen .top{display:flex;justify-content:space-between;font-size:12px;color:var(--dim)}
.screen .top b{color:var(--text)}
.stack{flex:1;display:grid;place-items:center;perspective:700px}
.stackin{position:relative;width:150px;height:170px;transform-style:preserve-3d;animation:spin3 7s ease-in-out infinite alternate}
.stackin i{position:absolute;left:0;right:0;border-radius:40px/20px;box-shadow:inset 0 -6px 10px rgba(0,0,0,.22)}
.stackin i:nth-child(1){top:6px;height:50px;background:#e0963f;border-radius:60px 60px 18px 18px;transform:translateZ(0)}
.stackin i:nth-child(2){top:62px;height:12px;background:#7dc23f;transform:translateZ(0) scaleX(1.08)}
.stackin i:nth-child(3){top:78px;height:12px;background:#ffb21c;transform:scaleX(1.05)}
.stackin i:nth-child(4){top:94px;height:24px;background:#573019}
.stackin i:nth-child(5){top:122px;height:34px;background:#d28a3a;border-radius:16px 16px 40px 40px}
@keyframes spin3{from{transform:rotateX(-14deg) rotateY(-32deg)}to{transform:rotateX(-14deg) rotateY(32deg)}}
.screen h4{font-size:16px}
.screen .btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.screen .btns span{display:grid;place-items:center;min-height:40px;border-radius:14px;font-size:12px;font-weight:700}
.screen .b1{background:var(--mint);color:#04140e}.screen .b2{background:var(--glass2);border:1px solid var(--edge)}
.callout{position:absolute;padding:10px 13px;border-radius:16px;display:grid;gap:6px;width:200px;transform:translateZ(60px)}
.callout .line{font-size:12.5px}
.co1{left:-3%;top:16%}.co2{right:-3%;top:46%}.co3{left:6%;bottom:-6%}

.cta{padding-block:clamp(60px,9vw,120px)}
.ctap{padding:clamp(40px,8vw,90px) 24px;border-radius:36px;text-align:center}
.ctap h2{font-size:clamp(28px,4.8vw,58px);max-width:14em;margin:16px auto}
.ctap p{color:#d6e8e2;max-width:34em;margin:0 auto 26px}
footer{padding:50px 0 calc(24px + env(safe-area-inset-bottom,0px));border-top:1px solid var(--edge);background:rgba(4,12,10,.7)}
.fr{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px;align-items:center;font-size:13px;color:var(--dim)}

/* modal */
.modal{position:fixed;inset:0;z-index:200;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(2,8,6,.7);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.modal.show{display:flex}
.mbox{position:relative;width:min(470px,100%);max-height:100%;overflow:auto;padding:30px;border-radius:28px;background:rgba(18,34,30,.8)}
.mbox h2{font-size:24px;margin:10px 0 8px}.mbox p{font-size:14px;color:var(--dim);margin-bottom:16px}
.x{position:absolute;right:14px;top:14px;width:40px;height:40px;border-radius:50%;border:1px solid var(--edge);background:var(--glass);font-size:22px;line-height:1}
.field{margin:12px 0}.field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;color:#d6e8e2}
.field input,.field select{width:100%;min-height:48px;padding:12px 14px;border-radius:14px;border:1px solid var(--edge);background:rgba(255,255,255,.07);color:var(--text);font:16px var(--body);outline:none}
.field select option{background:#10211d}
.field input:focus,.field select:focus{border-color:var(--mint)}
.mbox .btn{width:100%;margin-top:10px}
.sent{display:none}.mbox.done form{display:none}.mbox.done .sent{display:block}
.mail{display:flex;gap:8px;align-items:center;margin:14px 0;padding:12px 14px;border-radius:14px;background:rgba(255,255,255,.07);border:1px solid var(--edge);font-size:14px;word-break:break-all}
.mail button{margin-left:auto;flex:none;padding:6px 14px;border-radius:999px;border:1px solid var(--edge);background:none;font-size:12px}

.js .rv{opacity:0;transform:translateY(26px);transition:opacity .8s,transform .8s cubic-bezier(.2,.7,.2,1)}
.js .rv.in{opacity:1;transform:none}

@media (max-width:980px){
  .burger{display:block}
  .bar .desk{display:none}
  .links{position:fixed;inset:0;flex-direction:column;justify-content:center;gap:8px;padding:90px max(28px,env(safe-area-inset-left,0px)) 40px;background:rgba(5,14,12,.95);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);opacity:0;visibility:hidden;transition:.3s;z-index:-1}
  .links.open{opacity:1;visibility:visible}
  .links a{font:700 30px var(--display);letter-spacing:-.04em;color:var(--text);padding:6px 0}
  .story{height:480vh}
  .story-grid{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto;padding-top:calc(76px + env(safe-area-inset-top,0px));padding-bottom:calc(14px + env(safe-area-inset-bottom,0px));gap:8px}
  .area{order:-1;height:100%}
  .panel{padding:18px 18px 16px;border-radius:26px}
  .step{margin-bottom:10px}
  .panel h1,.panel h2{font-size:clamp(21px,6.2vw,28px);margin-bottom:8px}
  .panel .desc{font-size:14px;margin-bottom:12px}
  .panel .lines{gap:8px;padding-top:12px}
  .panel .line{font-size:13px}
  .cta-row{margin-top:14px}.cta-row .btn{flex:1 1 auto;min-height:42px}
  .scrollhint{display:none}
  .lab{width:190px;padding:10px 12px}
  .duo,.demo,.fgrid{grid-template-columns:1fr}
  .pscene{min-height:560px}
  .co1{left:-2%}.co2{right:-2%}
}
@media (max-width:520px){
  .logo small{display:none}
  .callout{width:164px;padding:8px 10px}
  .co1{top:6%}.co2{top:44%}.co3{bottom:2%}
  .phone{width:236px;height:480px}
}
@media (prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}html{scroll-behavior:auto}}
</style>

<div class="bg" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
<canvas id="gl" aria-hidden="true"></canvas>

<header>
  <div class="wrap">
    <div class="bar glass">
      <a href="#home" class="logo">LIVE<b>DISH</b>-AI<small>AR Menu</small></a>
      <nav class="links" id="links" aria-label="Main"><a href="#home">Experience</a><a href="#tech">AI + AR</a><a href="#features">Features</a><a href="#phone">Live preview</a><a href="#contact">Contact</a></nav>
      <button class="btn btn-main desk" data-demo>Book a demo</button>
      <button class="burger" id="burger" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>
</header>

<main>
<!-- STORY -->
<section class="story" id="home">
  <div class="stick" id="stick">
    <div class="wrap story-grid">
      <div class="panel glass" id="panel">
        <div class="step"><span id="stepLbl"><b>Step 1 of 5</b> · Scan</span><div class="dots" id="dots"><i></i><i></i><i></i><i></i><i></i></div></div>
        <div class="swap" id="swap">
          <h1 id="pTitle">The menu that sits on your table.</h1>
          <p class="desc" id="pDesc">LIVE DISH-AI AR Menu turns every dish into a 3D model that guests scan, place and order, with AI choosing what to show.</p>
          <div class="lines">
            <div class="line"><span class="chip ar">AR</span><span id="pAR">WebAR opens from the table QR. No app to install.</span></div>
            <div class="line"><span class="chip ai">AI</span><span id="pAI">Detects the guest's language and diet before the first dish loads.</span></div>
          </div>
        </div>
        <div class="cta-row" id="ctaRow"><button class="btn btn-main" data-demo>Book a demo</button><a class="btn btn-glass" href="#tech">How it works</a></div>
        <div class="scrollhint" id="hintS">Scroll to walk through the menu</div>
      </div>
      <div class="area" id="area">
        <div class="nogl-msg">Your browser can't show the 3D scene. The page still works below.</div>
        <div class="labels" id="labels">
          <div class="lab glass" id="lab-qr"><h4>Table QR</h4><div class="line"><span class="chip ar">AR</span>Opens WebAR instantly, no app</div><div class="line"><span class="chip ai">AI</span>Detects the guest's language</div></div>
          <div class="lab glass" id="lab-0"><h4>Smash burger</h4><div class="mc"><span class="chip ar">AR</span><span class="chip ai">AI</span></div><div class="line"><span class="chip ar">AR</span>Place it life-size on your table</div><div class="line"><span class="chip ai">AI</span>Pairs with fries, 92% match</div></div>
          <div class="lab glass" id="lab-1"><h4>Tonkotsu ramen</h4><div class="mc"><span class="chip ar">AR</span><span class="chip ai">AI</span></div><div class="line"><span class="chip ar">AR</span>Rotate and zoom to see the egg</div><div class="line"><span class="chip ai">AI</span>Spice level matched to taste</div></div>
          <div class="lab glass" id="lab-2"><h4>Glazed donut</h4><div class="mc"><span class="chip ar">AR</span><span class="chip ai">AI</span></div><div class="line"><span class="chip ar">AR</span>Compare the portion in 3D</div><div class="line"><span class="chip ai">AI</span>Allergen check: gluten, dairy</div></div>
          <div class="lab glass" id="lab-floor"><h4>AR surface and bounds</h4><div class="line"><span class="chip ar">AR</span>Table plane detected, dish anchored</div><div class="line"><span class="chip ai">AI</span>Scales the dish to real size, Ø 24 cm</div></div>
          <div class="lab glass" id="lab-ai"><h4>AI taste graph</h4><div class="line"><span class="chip ai">AI</span>Links ingredients to this guest</div><div class="line"><span class="chip ar">AR</span>Shows the match as tags on the dish</div></div>
        </div>
        <div class="toast glass" id="toast"><span class="ok">✓</span><span>Order sent to the kitchen display</span><span class="chip ar">AR</span><span class="chip ai">AI</span></div>
      </div>
    </div>
  </div>
</section>

<!-- TECH -->
<section class="s" id="tech">
  <div class="wrap">
    <div class="head rv"><div class="tag"><span class="chip ar">AR</span><span class="chip ai">AI</span></div><h2>Two technologies. One menu.</h2><p>AR shows the dish. AI decides what to show and explains it. Neither works as well alone.</p></div>
    <div class="duo">
      <div class="glass rv arc"><span class="chip ar">AR · Augmented reality</span><h3>See the dish before you order.</h3><p>WebAR runs in the phone browser, so there is nothing to download.</p>
        <ul><li>Life-size placement on the table</li><li>Spin, zoom and peel dishes in 3D</li><li>Floating ingredient and allergen tags</li><li>QR access from any table</li></ul></div>
      <div class="glass rv aic"><span class="chip ai">AI · Artificial intelligence</span><h3>Show each guest the right dish.</h3><p>AI reads the guest, the dish record and the kitchen, then does the routine work.</p>
        <ul><li>Taste and budget based recommendations</li><li>Automatic menu translation</li><li>Allergen checks against the guest profile</li><li>Prep time and upsell suggestions</li></ul></div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="s" id="features">
  <div class="wrap">
    <div class="head rv"><div class="tag"><span class="chip ar">AR</span><span class="chip ai">AI</span></div><h2>Every part of the AR Menu uses both.</h2><p>Tilt a card. Each feature lists what AR does and what AI does.</p></div>
    <div class="fgrid" id="fgrid"></div>
